  "classify": [
    {
      "q": "O destino é vídeo (Remotion)?",
      "yes": "interfaces em modo MOTION (moldes-index.modes.motion; painel #s04h-motion; guide §6b3) — texto vira barra, só o dado lido vira texto real. Landing/apresentação/site → modo completa (#s04g)."
    },
    {
      "q": "A fala descreve o uso de um app ou mostra dados/números de um sistema?",
      "yes": "family=interface → moldes-index family:interface; guide §6b2; panel #s04g-interfaces"
    },
    {
      "q": "A fala anuncia estrutura (três coisas / de X para Y / primeiro depois / muitos entram poucos chegam / gera e volta / níveis / um vira três / certo errado)?",
      "yes": "family=esquema|molde → guide §6b; panel #s04c-esquemas / #s04-moldes"
    },
    {
      "q": "A fala tem UMA ideia com peso (palavra, frase de 2–4 palavras, ou símbolo)?",
      "yes": "family=destaque → guide §6a (N1/N2/N3); panel #s04d-enfase"
    },
    {
      "q": "É o primeiro beat (0–5s)?",
      "yes": "gancho → guide §5b; panel #s04b-gancho"
    },
    {
      "q": "É a frase-resumo do vídeo, no clímax, com 6–22 palavras?",
      "yes": "lettering → guide §5c; panel #s04e-lettering (máx. 1 por vídeo)"
    },
    {
      "q": "É sensação, opinião ou fala corrida sem objeto?",
      "yes": "só legenda → guide §3a; nada no palco"
    }
  ],
