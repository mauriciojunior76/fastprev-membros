    "traco": {
      "guide": "§6 palavra",
      "tokens": "--z-underline-*",
      "spec": "6 a 95% da palavra, 12 abaixo, curva 3; 4 sob frase"
    },
    "selo": {
      "guide": "§1 / v1 §4",
      "tokens": "--z-r-seal --z-icon-seal --z-ring-spin",
      "spec": "220 raio 52 anel 6 (fecho) · 44 anel 3 (mini, cabeçalho); cinza quando outro item tem anel"
    },
    "icone": {
      "guide": "§7",
      "tokens": "--z-icon-* --z-icon-stroke-*",
      "spec": "Lucide, stroke clamp(1.25,2,160/tamanho); sempre em contêiner; escolhido por icons-map"
    }
