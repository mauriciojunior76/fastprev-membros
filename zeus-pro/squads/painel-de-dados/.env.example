# ─────────────────────────────────────────────────────────────────
#  zeus-dash · segredos de conexão
#  NÃO comite este arquivo com valores reais. O guia preenche sozinho:
#      node setup/wizard.js
# ─────────────────────────────────────────────────────────────────

# Supabase (OBRIGATÓRIO) — no painel do Supabase: Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook Ads (opcional — só se você anuncia)
# Token long-lived de System User com permissão ads_read
META_ACCESS_TOKEN=
# Conta de anúncio no formato act_SUA_CONTA_DE_ANUNCIOS
META_ACCOUNT=

# UTMify (opcional — usado no low ticket pra puxar as vendas)
UTMIFY_TOKEN=
# Segredo que protege o webhook de venda (o guia gera um automático)
WEBHOOK_SECRET=

# Porta do servidor
PORT=3000
