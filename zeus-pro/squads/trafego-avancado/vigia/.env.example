# Token Meta LONG-LIVED (Business Manager > Usuarios do sistema > Gerar token > nunca expira)
# Precisa da permissao ads_read (e ads_management se um dia o vigia for pausar conjunto)
META_ACCESS_TOKEN=

# Conta de anuncio a monitorar (formato act_XXXXXXXXXX). Pode tambem passar via --account.
META_AD_ACCOUNT_ID=

# Sua Evolution API (WhatsApp)
EVOLUTION_API_URL=https://sua-evolution.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sua-instancia

# Numero/JID que recebe os alertas (formato SEU_TELEFONE, ou grupo terminando em @g.us)
VIGIA_ALERT_NUMBER=

# Minutos entre ciclos no modo loop (default 15)
VIGIA_INTERVAL_MIN=15

# Onde gravar state.json e log.md (default: <esta pasta>/state)
VIGIA_STATE_DIR=
