{
  "_doc": "ROTEADOR do design system Zeus Reels. Entrada: um beat da transcrição (texto + t_inicio + t_fim). Saída: {entrada do índice, arquivos/seções onde está tudo, peças, gesto, restrições}. Ordem: 1) classificar o beat pelas perguntas; 2) casar triggers; 3) resolver 'where'; 4) se score 0, compor pelas peças (compose) e registrar. Nunca criar fora deste roteador.",
  "files": {
    "guide": "DESIGN-SYSTEM-REELS-APPLE-v2.md",
    "panel": "Zeus Reels Design System.dc.html",
    "tokens": "tokens/reels-tokens.css",
    "icons_map": "icons-map.json",
    "icons_log": "icons-log.json",
    "moldes_index": "moldes-index.json",
    "assets": "assets/"
  },
  "classify": [
    {
      "q": "A fala deste beat termina interrompida, cortada por outra pessoa, ou no meio da frase?",
      "yes": "fecho por palavra-conceito -> a ultima palavra ABSTRATA vira N3 (guide 6a) com traco do espectro, legenda cala, resto da frase so em audio, selo entra logo depois. A cauda da outra voz e cortada antes (ZOOM-REEL-MOTION.md P0b)"
    },
    {
      "q": "A fala descreve o uso de um app ou mostra dados/números de um sistema?",
      "yes": "family=interface → moldes-index family:interface; guide §6b2; panel #s04g-interfaces"
    },
    {
      "q": "A fala anuncia estrutura (três coisas / de X para Y / primeiro depois / muitos entram poucos chegam / gera e volta / níveis / um vira três / certo errado)?",
      "yes": "family=esquema|molde → guide §6b; panel #s04c-esquemas / #s04-moldes"
    },
    {
      "q": "A fala tem UMA ideia com peso (palavra, frase de 2–4 palavras, ou símbolo)?",
      "yes": "family=destaque → guide §6a (N1/N2/N3); panel #s04d-enfase"
    },
    {
      "q": "É o primeiro beat (0–5s)?",
      "yes": "gancho → guide §5b; panel #s04b-gancho"
    },
    {
      "q": "É a frase-resumo do vídeo, no clímax, com 6–22 palavras?",
      "yes": "lettering → guide §5c; panel #s04e-lettering (máx. 1 por vídeo)"
    },
    {
      "q": "É sensação, opinião ou fala corrida sem objeto?",
      "yes": "só legenda → guide §3a; nada no palco"
    }
  ],
  "always": {
    "legenda": "guide §3a/§3b · tokens --z-t-caption* --z-caption-*",
    "cor": "guide §1 · tokens --z-spectrum --z-ring*",
    "foco": "guide §2 · tokens --z-state-*",
    "movimento": "guide §9/§9d · tokens --z-ease-* --z-scene-* --z-focus-*",
    "simetria": "guide §6c",
    "massa": "guide §9b · token --z-solid-max",
    "traco": "guide §9c · tokens --z-icon-stroke-*",
    "icones": "guide §7 · icons-map.json → icons-log.json",
    "gabarito": "guide §8 · panel #s03-gabarito · tokens --z-stage-* --z-video-* --z-caption-center"
  },
  "pieces": {
