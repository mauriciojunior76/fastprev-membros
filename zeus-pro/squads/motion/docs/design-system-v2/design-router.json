    },
    "anel": {
      "guide": "§1",
      "tokens": "--z-ring --z-ring-md --z-ring-sm --z-spectrum",
      "spec": "3 ≤48 · 4 ≤100 · 6 >100; miolo branco; um por quadro; migra"
    },
    "no": {
      "guide": "§6b",
      "tokens": "--z-node",
      "spec": "círculo 148 (esquema) / 112 (passos, ciclo) / 80 (ramo); borda gray200 2 quando sem anel"
    },
    "conector": {
      "guide": "§6b",
      "tokens": "--z-connector --z-connector-w",
      "spec": "6 gray200, chevron 18 quando há direção; sempre cinza; desenha por dashoffset"
    },
    "rotulo": {
      "guide": "§5 (escala de rótulos)",
      "tokens": "--z-label-*",
      "spec": "Inter 600 caixa alta: 30 palco · 24 esquema · 22 interface · 18 meta · 16 micro"
    },
    "pill": {
      "guide": "§6 trio",
      "tokens": "--z-pill-h --z-r-pill",
      "spec": "64 alto, padding 24, glass; 44 dentro de painel (16/600)"
    },
    "linha-item": {
      "guide": "§6b tabela / §6b2 listas",
      "tokens": "--z-table-row",
      "spec": "60 (esquema) / 56–64 (interface), hairline gray100 entre"
    },
    "avatar": {
      "guide": "§6b2 perfil/leads",
      "tokens": "--z-ui-avatar",
      "spec": "círculo gray100 36–88; anel 3 quando em foco; anel do Instagram só citação"
    },
    "miniatura": {
      "guide": "§6b2 feed/perfil",
      "tokens": "--z-r-ui-thumb",
      "spec": "quadrado raio 8 gray100; em foco = branco borda 2 + anel 4; nunca preto"
    },
    "numero": {
      "guide": "§6b2 (tipo)",
      "tokens": "--z-t-ui-number --z-t-number",
      "spec": "Inter 700 tabular −0,01em; 24 interface · 34 KPI · 64 meta · 200 contagem (900)"
    },
    "traco": {
      "guide": "§6 palavra",
      "tokens": "--z-underline-*",
      "spec": "6 a 95% da palavra, 12 abaixo, curva 3; 4 sob frase"
    },
    "selo": {
      "guide": "§1 / v1 §4",
      "tokens": "--z-r-seal --z-icon-seal --z-ring-spin",
      "spec": "220 raio 52 anel 6 (fecho) · 44 anel 3 (mini, cabeçalho); cinza quando outro item tem anel"
    },
    "icone": {
      "guide": "§7",
      "tokens": "--z-icon-* --z-icon-stroke-*",
      "spec": "Lucide, stroke clamp(1.25,2,160/tamanho); sempre em contêiner; escolhido por icons-map"
    }
  },
  "gestures": {
    "range": "trilho/preenchimento desliza + número conta junto, settle 30q",
    "lista": "item entra por uma ponta (y ±16→0, settle 20q) e empurra",
    "contador": "preenche na palavra (scale .9→1, settle 16q), check desenha 12q",
    "tracado": "dashoffset até o ponto dito (settleSoft), espera a fala",
    "playback": "tempo real, única linear",
    "digitacao": "letra a letra 1,5q, sem blur",
    "confirmacao": "círculo preenche/vaza + check + número conta",
    "foco": "anel desliza 24q smoothInOut; recuo acompanha",
    "cascata": "irmãos entram a 4q (blocos) / 1,5q (letras) / 3q (palavras)",
    "contagem": "células preenchem a 4q; número interpola settleSoft"
  },
