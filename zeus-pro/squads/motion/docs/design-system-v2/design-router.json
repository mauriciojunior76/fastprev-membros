  "compose": {
    "rule": "Se nenhum trigger casa (score 0): escolha família pela classificação; monte com peças do dicionário acima, com as medidas do guia; escolha o gesto pela natureza (o que o olho espera); passe por §6c e §10; registre em moldes-index.json + specimen no painel (#s04g ou #s04c).",
    "examples": [
      {
        "beat": "ele manda o relatório por e-mail toda segunda",
        "compose": "painel + linha-item(avatar=selo) + numero(data) · gesto lista · família interface · tags #email #relatorio #rotina"
      },
      {
        "beat": "a mentoria tem 3 fases e cada fase tem 2 entregas",
        "compose": "passos (3 nós) + ramificacao (2 por nó, 2º nível) · gesto tracado+foco · família esquema"
      }
    ]
  },
