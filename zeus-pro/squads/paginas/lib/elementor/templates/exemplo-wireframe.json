{
  "name": "exemplo-standard",
  "description": "Wireframe padrao Exemplo - landing pages de mentoria/consultoria",
  "version": "1.0",
  "sections": [
    "alert-banner",
    "hero",
    "pain-points",
    "features",
    "how-it-works",
    "offer",
    "bio",
    "cta-final",
    "footer"
  ],
  "defaults": {
    "palette": {
      "gradient1": "#C0A24B",
      "gradient2": "#ECEAC3",
      "accentLight": "#F2E1A0",
      "shadowColor": "rgba(212, 168, 83, 0.3)",
      "bgLight": "#FFFFFF",
      "bgDark": "#0A0A0F",
      "bgAlt": "#111118",
      "textDark": "#3F4142",
      "textLight": "#FFFFFF",
      "textMuted": "#80838D"
    },
    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "accent": "DM Sans"
    },
    "responsive": {
      "sectionPadding": { "top": 100, "right": 20, "bottom": 100, "left": 20 },
      "sectionPaddingTablet": { "top": 80, "right": 20, "bottom": 80, "left": 20 },
      "sectionPaddingMobile": { "top": 60, "right": 20, "bottom": 60, "left": 20 },
      "headingSize": { "desktop": 52, "tablet": 44, "mobile": 32 },
      "subheadingSize": { "desktop": 28, "tablet": 24, "mobile": 20 },
      "bodySize": { "desktop": 18, "tablet": 16, "mobile": 16 },
      "smallSize": { "desktop": 14, "tablet": 14, "mobile": 12 },
      "gap": { "desktop": 40, "tablet": 30, "mobile": 20 }
    }
  },
  "customCSS": {
    "classes": ["balance", "gold", "gradient", "cta-button"],
    "grainOverlay": true
  }
}
