{
  "id": "minimal",
  "name": "Minimal",
  "owner": "generico",
  "description": "Branco + preto. Limpo, tipografico, focado em leitura. Sem efeitos.",
  "mood": ["limpo", "minimalista", "leitura", "tipografico"],
  "colors": {
    "bg": "#ffffff",
    "bg-alt": "#fafafa",
    "bg-card": "#f5f5f5",
    "accent-1": "#1a1a1a",
    "accent-2": "#333333",
    "accent-3": "#666666",
    "text": "#1a1a1a",
    "text-muted": "rgba(26, 26, 26, 0.65)",
    "text-label": "#666666",
    "border": "rgba(0, 0, 0, 0.12)",
    "divider": "rgba(0, 0, 0, 0.08)"
  },
  "fonts": {
    "title": {
      "family": "Inter",
      "weight": 700,
      "source": "google",
      "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    },
    "body": {
      "family": "Inter",
      "weight": 400,
      "source": "google"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": 400,
      "source": "google"
    }
  },
  "effects": {
    "grain": false,
    "gradient-titles": false,
    "corner-lines": false,
    "footer-diamond": false,
    "blur-reveal": false,
    "motion": "ease"
  },
  "logo": {
    "path": null,
    "width-px": 100,
    "position": "top-left"
  },
  "page": {
    "format": "A4",
    "width-mm": 210,
    "height-mm": 297,
    "padding-mm": 22,
    "background": "var(--bg)"
  },
  "icons": {
    "style": "stroke",
    "stroke-width": 1.5,
    "stroke-linecap": "round",
    "library": "lucide"
  },
  "typography-scale": {
    "h1": "48px",
    "h2": "32px",
    "h3": "22px",
    "body": "16px",
    "caption": "12px"
  },
  "cover": {
    "template": "cover-minimal.html",
    "style": "title-only-center"
  }
}
