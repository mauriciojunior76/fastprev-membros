{
  "id": "exemplo",
  "SOURCE-OF-TRUTH": "LER PRIMEIRO squads/book-forge/SOURCE-OF-TRUTH.md. A lei e docs/rules-on-demand/ebook-exemplo-padrao-oficial.md. O codigo canonico e templates/_oficiais-aprovados/exemplo-v2-template-oficial.html (clonar, nunca recriar CSS). Este JSON e metadado subordinado.",
  "name": "Exemplo",
  "owner": "o dono do canal",
  "description": "Rosegold + dark editorial. Luxo minimalista. Tema padrao o dono do canal/Exemplo.",
  "mood": ["luxo", "dark", "editorial", "sofisticado", "rosegold"],
  "colors": {
    "bg": "#0a0806",
