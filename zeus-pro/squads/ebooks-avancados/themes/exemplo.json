  "logo": {
    "path": "CAMINHO_DA_SUA_PASTA OFICIAL dourado vivo.png",
    "width-px": 120,
    "position": "center",
    "filter": "none"
  },
  "page": {
    "format": "A4",
    "width-mm": 210,
    "height-mm": 297,
    "padding-mm": 18,
    "background": "var(--bg)"
  },
  "icons": {
    "style": "stroke-square-corners",
    "viewBox": "0 0 24 24",
    "fill": "none",
    "stroke": "currentColor",
    "stroke-width": 1.2,
    "stroke-linecap": "square",
    "stroke-linejoin": "miter",
    "max-paths": 5,
    "live-area": "20x20",
    "library": "exemplo-300-official",
