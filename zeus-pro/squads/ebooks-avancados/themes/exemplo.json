    "bg-card": "#141210",
    "accent-1": "#b8887a",
    "accent-2": "#d4a08a",
    "accent-3": "#f0c8b0",
    "text": "#ffffff",
    "text-muted": "rgba(255, 255, 255, 0.55)",
    "text-label": "#d4a08a",
    "border": "rgba(212, 160, 138, 0.18)",
    "divider": "rgba(255, 255, 255, 0.08)",
    "off-white": "#FAF8F3"
  },
  "color-rules": {
    "FORBIDDEN": "DOURADO/GOLD em qualquer texto, gradiente, divisor ou elemento visual. O padrao Exemplo e ROSE GOLD (accent-1, accent-2, accent-3). Dourado existe APENAS dentro do arquivo de logo oficial (PNG), nunca recriado em CSS/SVG/texto.",
    "gradient-titles": "linear-gradient(170deg, #f0c8b0 0%, #d4a08a 45%, #b8887a 100%)",
    "note": "Escala gold-1..gold-5 REMOVIDA em 2026-06-10 apos erro registrado (e-book Lucas saiu com titulos dourados). Regra: docs/rules-on-demand/exemplo-color-standard.md"
  },
  "fonts": {
    "title": {
      "family": "Playfair Display",
      "weight": 700,
      "source": "google",
      "url": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&display=swap"
    },
    "title-alt": {
      "family": "Cormorant Garamond",
      "weight": 700,
      "source": "google",
      "url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap"
    },
    "body": {
      "family": "DM Sans",
      "weight": 400,
      "source": "google",
      "url": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap"
    },
    "body-alt": {
      "family": "Inter",
      "weight": 400,
      "source": "google",
      "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": 400,
      "source": "google"
    }
  },
  "effects": {
    "grain": true,
    "grain-opacity": 0.4,
    "gradient-titles": true,
    "corner-lines": true,
    "footer-diamond": true,
    "blur-reveal": true,
    "motion": "cubic-bezier(0.16, 1, 0.3, 1)"
