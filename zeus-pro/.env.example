# ZEUS PRO: modelo de configuração local
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o repositório.
# Nenhuma chave abaixo é obrigatória na instalação básica: o ZEUS funciona
# dentro do Claude Code sem nenhuma delas. Preencha só o que você for usar.

# ---- Caminhos locais ----
# Onde fica a sua Vault do Obsidian (deixe vazio para usar obsidian/vault-local)
ZEUS_VAULT_PATH=

# Seu nome, para o sistema saber como te chamar antes mesmo do boot
ZEUS_USUARIO=

# ---- Nível de autonomia (0 a 4). Instalação nova nasce em 1. ----
# 0 consulta | 1 planejamento | 2 execução local | 3 integrações | 4 rotinas
ZEUS_NIVEL_AUTONOMIA=1

# ---- Integrações opcionais (preencha só se for usar) ----
# Cada uma exige que você mesmo crie a chave na plataforma correspondente.
# O ZEUS nunca cria conta, nunca paga e nunca compra nada por você.

# Busca e pesquisa na web
CHAVE_BUSCA_WEB=

# Publicação de páginas em servidor próprio
SERVIDOR_HOST=
SERVIDOR_USUARIO=

# Geração de imagem
CHAVE_GERACAO_IMAGEM=

# Plataforma de anúncios (leitura de métricas)
CHAVE_ANUNCIOS=

# Banco de dados
URL_BANCO=
